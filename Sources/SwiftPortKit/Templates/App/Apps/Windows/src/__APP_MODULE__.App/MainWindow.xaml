<Window
    x:Class="__BUNDLE_ID__.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:__BUNDLE_ID__"
    mc:Ignorable="d"
    Title="__APP_NAME__">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <!-- Loading -->
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="40" Height="40"
                              HorizontalAlignment="Center"/>
                <TextBlock Text="Loading tasks…"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Empty -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="No Tasks" Style="{ThemeResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Add your first task using the field below."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Error -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="⚠" FontSize="36"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Couldn't Load Tasks" Style="{ThemeResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorText" MaxWidth="360" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <Button Content="Try Again" Click="OnRetry" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Loaded -->
            <ListView x:Name="TaskList" Visibility="Collapsed"
                      SelectionMode="None" Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TaskItem">
                        <Grid Padding="16,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayTitle}" FontSize="15"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Notes}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind NotesVisibility}"/>
                            </StackPanel>

                            <Border Grid.Column="2" VerticalAlignment="Center"
                                    Padding="8,3" CornerRadius="10"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind PriorityBadge}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>

                            <Button Grid.Column="3" VerticalAlignment="Center"
                                    Content="✕" Padding="8,4" BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    ToolTipService.ToolTip="Delete task"
                                    Click="OnDeleteTask"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Add-task bar — shared by empty and loaded states so a fresh
             install never dead-ends (same contract as the Apple UI). -->
        <Border x:Name="AddBar" Grid.Row="1" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="12">
                <TextBox x:Name="NewTaskBox" PlaceholderText="New task…"
                         Width="320" VerticalAlignment="Center"
                         KeyDown="OnNewTaskKeyDown"/>
                <Button Content="Add" Click="OnAddTask"
                        Style="{ThemeResource AccentButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

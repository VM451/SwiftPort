<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>__BUNDLE_ID__</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: runs without MSIX installation; `dotnet build` produces
         a plain .exe. Package as .msix later via Windows Package Manager. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <!-- Swift→C# bridge (generated by `swiftport sync` into Bridges/WindowsABI).
       Only compiled when the file exists so the project builds before sync. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\Bridges\WindowsABI\SwiftPortBridge.cs"
             Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\Bridges\WindowsABI\SwiftPortBridge.cs')" />
    <!-- Prebuilt AppCoreCABI.dll, if present under Bridges/WindowsABI/lib/. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\..\..\Bridges\WindowsABI\lib\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
